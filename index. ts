// index.ts — MagadanPowerBot v2.0 Production-Ready
// Архитектура: Чистый Webhook, Логирование, Защита от падений

import { Bot, webhookCallback } from "grammy";
import express from "express";

// 1. Строгая проверка окружения (early return)
const BOT_TOKEN = process.env.BOT_TOKEN;
if (!BOT_TOKEN) {
    throw new Error("⛔ BOT_TOKEN не найден в переменных окружения!");
}

// 2. Инициализация бота
const bot = new Bot(BOT_TOKEN);

// 3. Команда /start с обработкой ошибок
bot.command("start", async (ctx) => {
    try {
        const userName = ctx.from?.first_name || "Дорогой друг";
        
        await ctx.reply(
            `⚡ <b>MagadanPowerBot</b>\n\n` +
            `Здравствуйте, <b>${userName}</b>!\n\n` +
            `Вас приветствует эксперт-энергетик\n` +
            `с опытом работы в изолированной\n` +
            `энергосистеме более 27 лет.\n\n` +
            `Я помогу вам с документами,\n` +
            `тарифами и техприсоединением.\n\n` +
            `Нажмите /menu, чтобы начать.`,
            { parse_mode: "HTML" }
        );
        
        // Лог успеха
        console.log(`✅ Пользователь ${ctx.from?.id} запустил бота`);
    } catch (error) {
        console.error("❌ Ошибка в команде /start:", error);
        await ctx.reply("⚠️ Произошла ошибка. Пожалуйста, попробуйте позже.").catch(() => {});
    }
});

// 4. Заглушка для /menu
bot.command("menu", async (ctx) => {
    await ctx.reply(
        "📋 <b>Главное меню</b>\n\n" +
        "Выберите услугу:\n" +
        "1. Акт разграничения\n" +
        "2. Заявка на техприсоединение\n" +
        "3. Проверить тариф\n" +
        "4. Анализ потерь",
        { parse_mode: "HTML" }
    );
});

// 5. Обработчик любых текстовых сообщений (защита от падений)
bot.on("message:text", async (ctx) => {
    try {
        await ctx.reply(
            "Я вас слышу! 👂\n\n" +
            "Пока я нахожусь в разработке.\n" +
            "Напишите /start или /menu, чтобы\n" +
            "увидеть, что я уже умею."
        );
        console.log(`📩 Сообщение от ${ctx.from?.id}: "${ctx.message.text}"`);
    } catch (error) {
        console.error("❌ Ошибка в обработчике сообщений:", error);
    }
});

// 6. Production-Ready Express сервер с Webhook
const app = express();

// Парсим JSON тела запросов от Telegram
app.use(express.json());

// Webhook endpoint
app.post("/api/telegram", webhookCallback(bot, "express"));

// Обязательная проверка жизни для Vercel
app.get("/", (req, res) => {
    res.status(200).send("⚡ MagadanPowerBot работает! Эксперт на связи.");
});

// Запуск сервера на порту Vercel
const PORT = process.env.PORT || 3000;
app.listen(PORT, () => {
    console.log(`✅ Бот запущен на порту ${PORT}`);
    console.log("⚡ MagadanPowerBot готов к работе");
});

export default app;
